      "expected_agents": ["information_agent", "table_agent", "aggregator_agent"],
      "expected_answer_contains": ["$514", "billion", "2022"]
    },
    {
      "id": 2,
      "query": "What was Amazon's net income in 2021?",
      "complexity": "simple",
      "expected_agents": ["information_agent", "table_agent", "aggregator_agent"],
      "expected_answer_contains": ["net income", "2021"]
    },
    {
      "id": 3,
      "query": "Who is the CEO of Amazon?",
      "complexity": "simple",
      "expected_agents": ["information_agent", "aggregator_agent"],
      "expected_answer_contains": ["Andy Jassy"]
    }
  ],
  
