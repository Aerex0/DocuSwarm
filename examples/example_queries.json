{
  "simple_queries": [
    {
      "id": 1,
      "query": "What was Amazon's total net sales in 2022?",
      "complexity": "simple",
      "expected_agents": ["information_agent", "table_agent", "aggregator_agent"],
      "expected_answer_contains": ["2022", "net sales", "$514"]
    },
    {
      "id": 2,
      "query": "What was Amazon's net income (loss) in 2022?",
      "complexity": "simple",
      "expected_agents": ["information_agent", "table_agent", "aggregator_agent"],
      "expected_answer_contains": ["2022", "net income", "loss"]
    },
    {
      "id": 3,
      "query": "Who was Amazon's President and CEO in the 2022 report?",
      "complexity": "simple",
      "expected_agents": ["information_agent", "aggregator_agent"],
      "expected_answer_contains": ["Andy Jassy", "2022"]
    }
  ],

