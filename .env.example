# Groq API (Required)
GROQ_API_KEY=your_groq_api_key_here

# LlamaParse API (Required for Task 1)
LLAMAPARSE_API_KEY=your_llamaparse_api_key_here

# Web Search API (Optional)
TAVILY_API_KEY=your_tavily_api_key_here

# Paths
DATA_DIR=./data
CHROMADB_PATH=./data/chromadb
CACHE_DIR=./data/cache
PROCESSED_DIR=./data/processed

# System Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=False

# LangGraph Configuration
LANGGRAPH_CHECKPOINTER=memory
THREAD_ID_PREFIX=session_

# Rate Limiting
MAX_QUERIES_PER_MINUTE=30
MAX_RETRIES=3
RETRY_DELAY=2

# Chunking Configuration
DEFAULT_CHUNK_SIZE=1024
DEFAULT_CHUNK_OVERLAP=128
CHUNKING_STRATEGY=multimodal

# Retrieval Configuration
DEFAULT_TOP_K=10
SIMILARITY_THRESHOLD=0.7
USE_HYBRID_SEARCH=True

# Model Configuration
GROQ_MODEL_REASONING=openai/gpt-oss-120b
GROQ_MODEL_EMBEDDING=nomic-embed-text
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
# Reasoning models bill chain-of-thought against MAX_TOKENS; keep the per-call
# budget at or above this floor or answers can come back empty.
MIN_REASONING_MAX_TOKENS=4096

# LLM Parameters
TEMPERATURE=0.1
MAX_TOKENS=8000
TOP_P=0.95

# Cache Configuration
ENABLE_CACHE=True
CACHE_TTL=3600
CACHE_MAX_SIZE=100
